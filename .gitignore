.venv/
.venv-ml/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
/build/
.env

# Исходные выгрузки и локальное состояние сервиса не храним в Git.
*.zip
*.7z
data/raw/
data/*.db
data/models/
data/processed/
docs/source/

# При этом сохраняем структуру каталогов.
!data/.gitkeep
!docs/.gitkeep

# Reproducible audit outputs are tracked; bulk data and execution caches stay local.
analysis/deps/
analysis/extracted/
analysis/duckdb_tmp/
analysis/*.duckdb*
analysis/tz_page-*.png
