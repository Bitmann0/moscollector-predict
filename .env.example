# Скопируйте в .env и заполните. Файл .env в git не коммитится.
# Значения — латиница, цифры, «-» и «_»: compose подставляет $VAR внутри значений,
# а POSTGRES_PASSWORD попадает в DATABASE_URL без URL-кодирования.
# Секреты здесь пустые намеренно: пароли демо-пользователей не публикуются (решение D13 плана).

# Общий пароль демо-пользователей dispatcher, technician, analyst, manager, admin. Обязателен.
DEMO_PASSWORD=
# Ключ подписи cookie-сессий. Любая длинная случайная строка. Обязателен.
SECRET_KEY=
# Ключ для машинных клиентов (replay.py, эмуляторы): заголовок X-API-Key.
INTEGRATION_API_KEY=

# Демо-«сегодня»: данные заказчика кончаются 30.06.2026 (решение D6).
DEMO_TODAY=2026-06-30
# 1 — закрыть изменение демо-настроек (стенд, решение D13).
DEMO_SETTINGS_LOCKED=0
# 1 — при старте создать демо-пользователей, справочник причин и синтетический справочник объектов.
SEED_DEMO=1

# Режим ML-сервиса: stub — заглушки без данных, real — реальные модели из бандла C4.
ML_MODE=stub

# --- Необязательные ---
# PostgreSQL в compose (по умолчанию moscollector/moscollector/moscollector).
# POSTGRES_DB=moscollector
# POSTGRES_USER=moscollector
# POSTGRES_PASSWORD=
# Каталог бандла C4 для compose.real.yaml (по умолчанию ./bundle).
# BUNDLE_DIR=./bundle
# Домен стенда для compose.stand.yaml (Caddy получает TLS-сертификат).
# STAND_DOMAIN=
# Запуск без Docker (из корня репозитория, ML-заглушка на порту 8001):
# DATABASE_URL=sqlite:///./data/dev.db
# ML_URL=http://localhost:8001

# --- Вход через корпоративный каталог LDAP/AD (backend/app/directory.py) ---
# Пустой LDAP_URL — вход только по локальным учётным записям, как без каталога. Готовый
# набор значений для тестового каталога — в compose.ldap.yaml. В значениях LDAP
# допустимы «=», «,», скобки и фигурные скобки; «$» — нет. JSON — в одинарных кавычках.
# Адрес каталога: ldaps://хост:636 или ldap://хост:389. Для проверки сертификата — имя
# хоста, не IP-адрес: ldap3 сверяет с сертификатом только DNS-имена.
# LDAP_URL=ldaps://dc01.corp.example:636
# 1 — StartTLS поверх ldap://.
# LDAP_STARTTLS=0
# CA каталога в формате PEM; пусто — системные CA.
# LDAP_TLS_CA_FILE=
# 0 — не проверять сертификат каталога. Только для теста.
# LDAP_TLS_VERIFY=1
# Секунд на соединение и на каждый ответ каталога; ожидание ответа округляется вверх до целых.
# LDAP_TIMEOUT_S=5
# Сотрудник находится по шаблону DN (bind сразу под ним; в AD подходит {login}@домен)…
# LDAP_USER_DN_TEMPLATE=uid={login},ou=people,dc=corp,dc=example
# …или поиском под служебной учётной записью; без LDAP_BIND_DN поиск анонимный.
# LDAP_BIND_DN=cn=svc-moscollector,ou=service,dc=corp,dc=example
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE=ou=people,dc=corp,dc=example
# В AD: (sAMAccountName={login}).
# LDAP_USER_FILTER=(uid={login})
# Группы — атрибут memberOf сотрудника и поиск в LDAP_GROUP_BASE.
# LDAP_GROUP_BASE=ou=groups,dc=corp,dc=example
# LDAP_GROUP_FILTER=(|(member={user_dn})(uniqueMember={user_dn})(memberUid={login}))
# Группа → роль, группа задаётся CN или DN. Если совпало несколько, берётся роль,
# записанная раньше. Без группы из этого списка вход — 403 no_role_in_directory.
# LDAP_ROLE_GROUPS=admin=mk-admins;dispatcher=mk-dispatchers;technician=mk-technicians;analyst=mk-analysts;manager=mk-managers
# LDAP_ROLE_GROUPS='{"admin": ["cn=MK Admins,ou=groups,dc=corp,dc=example"], "dispatcher": "mk-dispatchers"}'
# 1 — при заданном LDAP_URL пускать и локальные учётные записи (демо), 0 — только каталог.
# LDAP_ALLOW_LOCAL=1
