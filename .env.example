# Скопируйте в .env и заполните. Файл .env в git не коммитится.
# Секреты здесь пустые намеренно: пароли демо-пользователей не публикуются (решение D13 плана).

# Общий пароль демо-пользователей dispatcher, technician, analyst, manager, admin. Обязателен.
DEMO_PASSWORD=
# Ключ подписи cookie-сессий. Любая длинная случайная строка. Обязателен.
SECRET_KEY=
# Ключ для машинных клиентов (replay.py, эмуляторы): заголовок X-API-Key.
INTEGRATION_API_KEY=

# Демо-«сегодня»: данные заказчика кончаются 30.06.2026 (решение D6).
DEMO_TODAY=2026-06-30
# 1 — закрыть изменение демо-настроек (стенд, решение D13).
DEMO_SETTINGS_LOCKED=0
# 1 — при старте создать демо-пользователей, справочник причин и синтетический справочник объектов.
SEED_DEMO=1

# Режим ML-сервиса: stub — заглушки без данных, real — реальные модели из бандла C4.
ML_MODE=stub
