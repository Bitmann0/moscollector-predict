    <дата>2026-06-30</дата>
    <время>10:00:00</время>
    <тревожное>t</тревожное>
    <значение_датчика>Обнаружен газ</значение_датчика>
  </EventRowIn>
  <EventRowIn>
    <ид_события>900002</ид_события>
    <ид_канала_данных>9000004</ид_канала_данных>
    <дата>2026-06-30</дата>
    <время>10:20:00</время>
    <тревожное>f</тревожное>
    <значение_датчика>0,4</значение_датчика>
  </EventRowIn>
  <EventRowIn>
    <ид_события>900003</ид_события>
    <ид_канала_данных>9000001</ид_канала_данных>
