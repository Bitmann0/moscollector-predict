# ЗАГЛУШКА — владелец PM-10 (стенд, D9).
# Заменить: заголовки безопасности, журнал доступа, ограничение частоты входа.
# Контракт: весь трафик идёт на api:8000, /api/v1/stream (SSE) не буферизуется;
# scripts/smoke_compose.py --base-url https://$STAND_DOMAIN должен остаться зелёным.
#
# Сертификат Caddy получает сам (ACME) для домена из STAND_DOMAIN: DNS домена должен
# указывать на ВМ, порты 80 и 443 открыты.
{$STAND_DOMAIN} {
	# Предел тела как в backend/app/limits.py: крупнее — только загрузка журнала.
	request_body {
		max_size 200MB
	}
	reverse_proxy api:8000 {
		# SSE: события уходят в браузер сразу, без накопления в буфере прокси.
		flush_interval -1
	}
}
