# Стенд (PM-10, решения D9 и D13): весь трафик идёт на api:8000, TLS держит Caddy.
#
# Сертификат Caddy получает сам (ACME) для домена из STAND_DOMAIN: DNS домена должен
# указывать на ВМ, порты 80 и 443 открыты. Для проверки на своей машине подходит
# STAND_DOMAIN=localhost: Caddy выпустит сертификат своим локальным CA.
# Частоту входа ограничивает api (routers/auth.py): в caddy:2-alpine нет модуля rate limit.
# Проверка: python scripts/smoke_compose.py --base-url https://$STAND_DOMAIN
{$STAND_DOMAIN} {
	# Предел тела как в backend/app/limits.py: крупнее — только загрузка журнала.
	request_body {
		max_size 200MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Журнал доступа — в stdout контейнера; ротацию задаёт logging в compose.stand.yaml.
	log {
		output stdout
		format json
	}

	reverse_proxy api:8000 {
		# SSE: события уходят в браузер сразу, без накопления в буфере прокси.
		flush_interval -1
		# Простаивающее соединение к api живёт 60 с, а api держит его 75 с
		# (backend/entrypoint.sh): Caddy не отправит запрос в соединение,
		# которое api уже закрыл.
		transport http {
			keepalive 60s
		}
	}
}
