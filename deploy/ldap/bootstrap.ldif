# Тестовый каталог для compose.ldap.yaml. ТОЛЬКО ДЛЯ ТЕСТА.
# Образ osixia/openldap загружает файл при первом старте с пустым томом (переменная
# LDAP_SEED_INTERNAL_LDIF_PATH в compose.ldap.yaml). Корень dc=moscollector,dc=test и служебную
# запись cn=readonly,dc=moscollector,dc=test образ создаёт сам.
#
# По сотруднику на роль продукта и один без роли. Роль даёт группа mk-<роль>s
# (LDAP_ROLE_GROUPS в compose.ldap.yaml); ldap-norole состоит только в mk-visitors,
# которая роли не даёт. Группы groupOfUniqueNames: по ним оверлей memberof образа
# заполняет memberOf у сотрудника.
#
# userPassword — хеши {SSHA} паролей из deploy/ldap/test-directory.env.example.
# Сменили пароль там — замените хеш здесь: slappasswd -s <пароль> в контейнере ldap.

dn: ou=people,dc=moscollector,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=moscollector,dc=test
objectClass: organizationalUnit
ou: groups

dn: uid=ldap-dispatcher,ou=people,dc=moscollector,dc=test
objectClass: inetOrgPerson
uid: ldap-dispatcher
cn: ldap-dispatcher
sn:: 0JTQuNGB0L/QtdGC0YfQtdGA
